.initial-input-area { --input-area-padding-inline: 0px; margin-inline-start: var(--input-area-margin-inline-start); display: flex; padding-inline: var(--input-area-padding-inline); position: absolute; width: calc(100% - var(--input-area-margin-inline-start) - var(--input-area-padding-inline)*2); z-index: 2; }

